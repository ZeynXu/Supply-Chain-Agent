{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intent Output Schema",
  "description": "意图解析输出规范",
  "type": "object",
  "required": ["intent_level_1", "intent_level_2", "entities"],
  "properties": {
    "intent_level_1": {
      "type": "string",
      "enum": ["信息查询", "工单管理", "异常上报"],
      "description": "一级意图分类"
    },
    "intent_level_2": {
      "type": "string",
      "enum": [
        "客户查询", "客户订单查询", "订单查询", "订单明细查询",
        "产品查询", "物流查询", "客户统计查询", "工单查询",
        "创建工单", "审批工单", "上报问题"
      ],
      "description": "二级意图分类"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "type": "string",
            "description": "实体类型"
          },
          "value": {
            "type": ["string", "number"],
            "description": "实体值"
          }
        }
      },
      "description": "提取的实体列表"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "置信度分数"
    },
    "required_slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "需要的槽位列表"
    }
  }
}
